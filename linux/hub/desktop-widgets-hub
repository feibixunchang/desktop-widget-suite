def download(url, token, dest, progress=None, api_url=None):
    # 私有仓库的 browser_download_url 302 到 S3 时 Authorization 头会丢，
    # 直接下必 404。有 API 资产地址（/releases/assets/<id>）就优先走它，
    # Accept: application/octet-stream + Bearer token 可直接拿到字节流。
    target = api_url if (api_url and token) else url
    req = urllib.request.Request(target, headers={
        'User-Agent': 'desktop-widgets-hub/%s' % VERSION,
        'Accept': 'application/octet-stream',
    })
    if token:
        req.add_header('Authorization', 'Bearer ' + token)
    with urllib.request.urlopen(req, timeout=60) as r, open(dest, 'wb') as f:
        total = int(r.headers.get('Content-Length') or 0)
        got = 0
        while True:
            chunk = r.read(65536)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            if progress and total:
                progress(got, total)
    return dest


def install_deb_root(path):
    """以 root 身份安装 .deb（Deepin 不可变系统优先走 immutable-ctl）。"""
    cmds = []
    if shutil.which('deepin-immutable-ctl'):
        cmds.append(['deepin-immutable-ctl', 'admin', 'exec', '--',
                     'dpkg', '-i', '--force-confask,confnew,overwrite', path])
    cmds.append(['dpkg', '-i', '--force-confask,confnew,overwrite', path])
    last = 1
    for cmd in cmds:
        try:
            r = subprocess.run(cmd)
            last = r.returncode
            if last == 0:
                subprocess.run(['apt-get', 'install', '-f', '-y'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return 0
        except Exception as e:
            print('install failed: %s' % e, file=sys.stderr)
    return last


# ── 平滑滚动 ─────────────────────────────────────────────
def _install_scroller(scrolled, classes):
    from gi.repository import Gdk, GLib

    adj = scrolled.get_vadjustment()
    state = {'target': None, 'tick': None, 'drag_y': None, 'drag_v': 0.0}
    step = 74.0

    def clamp(v):
        lo = adj.get_lower()
        hi = max(lo, adj.get_upper() - adj.get_page_size())
        return max(lo, min(hi, v))

    def animate():
        tgt = state['target']
        if tgt is None:
            state['tick'] = None
            return False
        cur = adj.get_value()
        diff = tgt - cur
        if abs(diff) < 0.7:
            adj.set_value(tgt)
            state['target'] = None
            state['tick'] = None
            return False
        adj.set_value(cur + diff * 0.36)
        return True

    def on_scroll(widget, ev):
        d = ev.direction
        delta = 0.0
        if d == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            if not ok:
                return False
            delta = dy * step * 1.25
        elif d == Gdk.ScrollDirection.UP:
            delta = -step
        elif d == Gdk.ScrollDirection.DOWN:
            delta = step
        else:
            return False
        cur = state['target'] if state['target'] is not None else adj.get_value()
        state['target'] = clamp(cur + delta)
        if state['tick'] is None:
            state['tick'] = GLib.timeout_add(15, animate)
        return True

    def on_press(widget, ev):
        if ev.button != 1:
            return False
        if isinstance(ev.widget, classes):
            return False       # 点在按钮 / 开关上，交给控件自己处理
        state['drag_y'] = ev.y_root
        state['drag_v'] = adj.get_value()
        state['target'] = None
        return True

    def on_motion(widget, ev):
        if state['drag_y'] is None:
            return False
        dy = ev.y_root - state['drag_y']
        if abs(dy) > 2:
            adj.set_value(clamp(state['drag_v'] - dy))
        return True

    def on_release(widget, ev):
        state['drag_y'] = None
        return False

    scrolled.add_events(Gdk.EventMask.SMOOTH_SCROLL_MASK)
    scrolled.connect('scroll-event', on_scroll)
    scrolled.connect('button-press-event', on_press)
    scrolled.connect('button-release-event', on_release)
    scrolled.connect('motion-notify-event', on_motion)


# ── 界面 ─────────────────────────────────────────────────
def build_ui():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib, Gio, Pango

    def icon_btn(icon_name, tip, fallback, cb):
        theme = Gtk.IconTheme.get_default()
        if icon_name and theme.has_icon(icon_name):
            b = Gtk.Button()
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
            b.add(img)
            b.set_relief(Gtk.ReliefStyle.NONE)
        else:
            b = Gtk.Button(label=fallback)
        b.set_tooltip_text(tip)
        b.connect('clicked', lambda *_a: cb())
        return b

    class WidgetSettingsDialog(Gtk.Dialog):
        def __init__(self, parent, key, on_saved):
            _k, cmd, pattern, label = WIDGET_MAP[key]
            conf = wconf(key)
            super().__init__(title='设置 · %s' % label, transient_for=parent, modal=True)
            self.set_default_size(440, -1)
            self.add_button('取消', Gtk.ResponseType.CANCEL)
            self.add_button('保存', Gtk.ResponseType.OK)
            self.key = key
            self.on_saved = on_saved

            box = self.get_content_area()
            box.set_spacing(10)
            box.set_margin_start(16); box.set_margin_end(16)
            box.set_margin_top(14); box.set_margin_bottom(6)

            head = Gtk.Label()
            head.set_markup('<b>%s</b>\n<span foreground="#888888" size="small">%s</span>'
                            % (label, key))
            head.set_xalign(0)
            box.pack_start(head, False, False, 0)

            grid = Gtk.Grid(column_spacing=12, row_spacing=8)
            box.pack_start(grid, False, False, 0)
            r = 0

            def add_row(text, widget, tip=None):
                nonlocal r
                lbl = Gtk.Label(label=text)
                lbl.set_xalign(0)
                if tip:
                    lbl.set_tooltip_text(tip)
                grid.attach(lbl, 0, r, 1, 1)
                widget.set_hexpand(True)
                grid.attach(widget, 1, r, 1, 1)
                r += 1
                return widget

            self.e_cmd = add_row('启动命令', Gtk.Entry())
            self.e_cmd.set_text(cmd)
            self.e_cmd.set_sensitive(False)

            self.e_args = add_row('附加参数', Gtk.Entry(), '例如 --no-sound，追加在启动命令之后')
            self.e_args.set_text(conf.get('args') or '')
            self.e_args.set_placeholder_text('留空表示默认')

            self.sp_delay = add_row('崩溃重启延迟', Gtk.SpinButton.new_with_range(0, 600, 1),
                                    '挂件异常退出后等待多少秒再拉起（由守护遵守）')
            self.sp_delay.set_value(int(conf.get('delay') or 0))

            self.sw_auto = add_row('自动重启', Gtk.Switch(),
                                   '关闭后该挂件崩溃不会被守护拉起，也不会开机自动启动')
            self.sw_auto.set_active(bool(conf.get('auto_restart', True)))
            self.sw_auto.set_halign(Gtk.Align.START)

            sysfont = Gtk.Label()
            sysfont.set_markup('<span foreground="#888888" size="small">%s</span>' % _system_font_hint())
            self.e_font = add_row('挂件字体', Gtk.Entry(),
                                  '留空跟随系统默认字体；填写字体族名可单独指定该挂件字体')
            self.e_font.set_text(conf.get('font') or '')
            self.e_font.set_placeholder_text('跟随系统默认')
            grid.attach(sysfont, 1, r, 1, 1)
            r += 1

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            b_dir = Gtk.Button(label='打开安装目录')
            b_dir.connect('clicked', lambda *_a: _open_dir(os.path.dirname(pattern)))
            row.pack_start(b_dir, False, False, 0)
            b_cfg = Gtk.Button(label='打开配置目录')
            b_cfg.connect('clicked', lambda *_a: _open_dir(MARK_DIR))
            row.pack_start(b_cfg, False, False, 0)
            self.sw_restart = Gtk.CheckButton(label='保存后重启该挂件')
            self.sw_restart.set_active(True)
            row.pack_end(self.sw_restart, False, False, 0)
            box.pack_start(row, False, False, 0)

            note = Gtk.Label()
            note.set_markup('<span foreground="#888888" size="small">'
                            '字体设置只对支持字体跟随的挂件生效，保存后建议重启该挂件。</span>')
            note.set_xalign(0)
            note.set_line_wrap(True)
            box.pack_start(note, False, False, 4)

            self.connect('response', self._on_response)
            self.show_all()

        def _on_response(self, dlg, resp):
            if resp == Gtk.ResponseType.OK:
                conf = {
                    'args': self.e_args.get_text().strip(),
                    'delay': int(self.sp_delay.get_value()),
                    'auto_restart': bool(self.sw_auto.get_active()),
                    'font': self.e_font.get_text().strip(),
                }
                set_wconf(self.key, conf)
                _write_font_override(self.key, conf['font'])
                if self.sw_restart.get_active() and is_running(WIDGET_MAP[self.key][2]):
                    stop_widget(WIDGET_MAP[self.key][2])
                    GLib.timeout_add(900, lambda: (start_widget(widget_cmd(self.key)), False)[1])
                self.on_saved(self.key)
            self.destroy()

    def _open_dir(path):
        try:
            if os.path.isdir(path):
                subprocess.Popen(['xdg-open', path], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print('open dir failed: %s' % e, file=sys.stderr)

    def _system_font_hint():
        try:
            out = subprocess.check_output(['gsettings', 'get', 'org.gnome.desktop.interface', 'font-name'],
                                          stderr=subprocess.DEVNULL, timeout=4).decode().strip()
            out = out.strip("'").strip('"')
            parts = out.rsplit(None, 1)
            name = parts[0] if len(parts) == 2 and parts[1].isdigit() else out
            return '系统默认：%s' % name
        except Exception:
            return '系统默认字体'

    def _write_font_override(key, font):
        path = os.path.join(MARK_DIR, 'font-%s.txt' % key)
        try:
            os.makedirs(MARK_DIR, exist_ok=True)
            if font:
                with open(path, 'w') as f:
                    f.write(font + '\n')
            elif os.path.exists(path):
                os.remove(path)
        except Exception as e:
            print('font override failed: %s' % e, file=sys.stderr)

    def _open_url(url):
        try:
            Gio.AppInfo.launch_default_for_uri(url, None)
        except Exception:
            subprocess.Popen(['xdg-open', url], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    return (Gtk, Gdk, GLib, Gio, Pango, icon_btn, WidgetSettingsDialog, _open_dir, _open_url)


