def _ver_tuple(s):
    out = []
    for part in str(s).strip().lstrip('vV').split('.'):
        num = ''
        for ch in part:
            if ch.isdigit():
                num += ch
            else:
                break
        out.append(int(num) if num else 0)
    while len(out) < 3:
        out.append(0)
    return tuple(out)


def installed_version():
    """当前【正在运行】的版本。

    以前读 dpkg-query 的文件版本，会出现「标题栏显示旧版、检查更新却说
    已是最新」的矛盾（安装完新包但旧进程还在内存里）。改为返回本进程的
    VERSION：检查更新基于真实运行版本，装完重启后自然一致。
    """
    return VERSION


