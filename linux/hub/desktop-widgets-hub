def _http_json(url, token='', timeout=12):
    req = urllib.request.Request(url, headers={
        'Accept': 'application/vnd.github+json',
        'User-Agent': 'desktop-widgets-hub/%s' % VERSION,
    })
    if token:
        req.add_header('Authorization', 'Bearer ' + token)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode('utf-8'))


def _deb_version(name):
    """从 deb 资产名解析版本：desktop-widgets-suite_2.9.81_all.deb → '2.9.81'。

    不能直接用 tag_name：本仓库同时发 Windows（win-vX.Y，只有 exe）和
    Linux（linux-vX.Y.Z，带 .deb）两种 release，tag 带平台前缀，
    _ver_tuple('linux-v2.9.81') 会解析成 (0,9,81)，比已装版本还"旧"。
    """
    base = (name or '').lower()
    if not base.endswith('_all.deb') or '_' not in base[:-len('_all.deb')]:
        return ''
    return base[:-len('_all.deb')].rsplit('_', 1)[1]


def check_update():
    """返回 dict: {'ok':bool, 'latest':str, 'url':str, 'notes':str, 'error':str, 'need_token':bool}"""
    cfg = load_update_cfg()
    res = {'ok': False, 'latest': '', 'url': '', 'api_url': '', 'notes': '', 'error': '', 'need_token': False}
    try:
        if cfg.get('feed'):
            data = _http_json(cfg['feed'], cfg.get('token', ''))
            res['latest'] = str(data.get('version') or data.get('tag_name') or '').lstrip('vV')
            res['url'] = data.get('deb') or data.get('url') or ''
            res['notes'] = data.get('notes') or data.get('body') or ''
        else:
            # 旧写法查 releases/latest：该接口按发布时间取"最新"release，而本仓库
            # 最新的往往是 Windows release（win-vX.Y，只带 WidgetHubSetup.exe）
            # → 误报"最新发行版里没有 .deb 资源"（检查失败）。
            # 改为列出最近 release，取【第一个带 .deb 资产】的，自动跳过
            # Windows-only / draft / prerelease；版本号从 deb 资产名解析。
            url = 'https://api.github.com/repos/%s/releases?per_page=30' % cfg['repo']
            data = _http_json(url, cfg.get('token', ''))
            if not isinstance(data, list):
                res['error'] = '仓库返回数据异常'
                return res
            for rel in data:
                if rel.get('draft') or rel.get('prerelease'):
                    continue
                deb_asset = None
                for asset in rel.get('assets') or []:
                    if (asset.get('name') or '').lower().endswith('.deb'):
                        deb_asset = asset
                        break
                if deb_asset is None:
                    continue
                ver = _deb_version(deb_asset.get('name'))
                if not ver:
                    continue
                res['latest'] = ver
                res['url'] = deb_asset.get('browser_download_url') or ''
                # 私有仓库：browser_download_url 会 302 到 S3 且丢 Authorization
                # → 下载 404（Windows 端 WidgetHub 同坑）。留存 API 资产接口
                # 地址，download() 优先走它。
                aid = deb_asset.get('id')
                if aid:
                    res['api_url'] = ('https://api.github.com/repos/%s/releases/assets/%s'
                                      % (cfg['repo'], aid))
                res['notes'] = rel.get('body') or ''
                break
            if not res['url']:
                res['error'] = '最近的发行版里没有 .deb 资源（Windows release 会被自动跳过）'
                return res
        if not res['latest']:
            res['error'] = '未能解析版本号'
            return res
        res['ok'] = True
        return res
    except urllib.error.HTTPError as e:
        if e.code in (401, 404):
            res['error'] = '私有仓库需要访问令牌（设置 → 更新）'
            res['need_token'] = True
        elif e.code == 403:
            res['error'] = 'GitHub 拒绝访问（令牌无 release 权限或已限流）'
            res['need_token'] = True
        else:
            res['error'] = 'HTTP %s' % e.code
        return res
    except Exception as e:
        res['error'] = '网络不可用：%s' % e
        return res


