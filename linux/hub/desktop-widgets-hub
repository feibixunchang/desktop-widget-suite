_settings_cache = {'mtime': None, 'data': {}}


def load_settings():
    """读取设置，按 mtime 缓存（每 3 秒刷新界面时不再重复解析 JSON）。"""
    try:
        mtime = os.path.getmtime(SETTINGS_PATH)
    except OSError:
        _settings_cache['mtime'] = None
        _settings_cache['data'] = {}
        return _settings_cache['data']
    if _settings_cache['mtime'] == mtime:
        return _settings_cache['data']
    try:
        with open(SETTINGS_PATH) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}
    _settings_cache['mtime'] = mtime
    _settings_cache['data'] = data
    return data


def save_settings(data):
    try:
        os.makedirs(MARK_DIR, exist_ok=True)
        tmp = SETTINGS_PATH + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        os.replace(tmp, SETTINGS_PATH)
        _settings_cache['mtime'] = None
        _settings_cache['data'] = {}
        return True
    except Exception as e:
        print('save settings failed: %s' % e, file=sys.stderr)
        return False


def wconf(key):
    conf = dict(DEFAULT_WCONF)
    conf.update(load_settings().get(key) or {})
    return conf


def set_wconf(key, conf):
    data = load_settings()
    data[key] = {k: conf.get(k, v) for k, v in DEFAULT_WCONF.items()}
    return save_settings(data)


# ── 进程状态（单次 /proc 快照，避免 17 次 pgrep 卡住界面） ──
def _proc_cmdlines():
    """收集全机进程命令行。

    同时用两种方式：直接读 /proc（真实桌面会话）与一次 `pgrep -af .`
    （某些容器/沙箱里 /proc 被裁剪时兜底），合并去重。
    每次刷新只发一次外部进程，界面不会卡。
    """
    me = str(os.getpid())
    lines = []

    def add(line):
        line = line.strip()
        if not line:
            return
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0] == me:
            return
        lines.append(line)

    try:
        for pid in os.listdir('/proc'):
            if not pid.isdigit():
                continue
            try:
                with open('/proc/%s/cmdline' % pid, 'rb') as f:
                    raw = f.read()
            except OSError:
                continue
            if raw:
                add(raw.replace(b'\0', b' ').decode('utf-8', 'replace'))
    except OSError:
        pass
    try:
        out = subprocess.run(['pgrep', '-af', '.'], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=6).stdout
        for line in out.decode('utf-8', 'replace').splitlines():
            if 'pgrep' in line.split(None, 1)[-1][:8]:
                continue
            add(line)
    except Exception:
        pass
    return lines


def running_keys():
    snap = _proc_cmdlines()
    found = set()
    for key, _cmd, pattern, _label in WIDGETS:
        for line in snap:
            if pattern in line:
                found.add(key)
                break
    return found


def is_running(pattern):
    for line in _proc_cmdlines():
        if pattern in line:
            return True
    return False


