def run_app():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib, Gio

    (Gtk, Gdk, GLib, Gio, Pango, icon_btn,
     WidgetSettingsDialog, open_dir, open_url) = build_ui()

    ICON = ensure_icon()

    class HubRow(Gtk.ListBoxRow):
        def __init__(self, key, cmd, pattern, label, win):
            super().__init__()
            self.key = key
            self.base_cmd = cmd
            self.pattern = pattern
            self.label = label
            self.win = win
            self._updating = False

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            box.set_margin_start(12); box.set_margin_end(10)
            box.set_margin_top(5); box.set_margin_bottom(5)
            self.add(box)

            self.dot = Gtk.Label()
            self.dot.set_markup('<span foreground="#b0b0b0">●</span>')
            self.dot.set_size_request(14, -1)
            box.pack_start(self.dot, False, False, 0)

            self.name = Gtk.Label()
            self.name.set_ellipsize(Pango.EllipsizeMode.END)
            self.name.set_max_width_chars(18)
            self.name.set_xalign(0)
            box.pack_start(self.name, True, True, 0)

            self.switch = Gtk.Switch()
            self.switch.set_valign(Gtk.Align.CENTER)
            self.switch.connect('notify::active', self._on_switch)
            box.pack_start(self.switch, False, False, 0)

            b_set = icon_btn('preferences-system', '设置', '设置', self.open_settings)
            box.pack_start(b_set, False, False, 0)
            b_re = icon_btn('view-refresh', '重启', '重启', self.do_restart)
            box.pack_start(b_re, False, False, 0)
            b_st = icon_btn('process-stop', '停止', '停止', self.do_stop)
            box.pack_start(b_st, False, False, 0)

        def open_settings(self):
            WidgetSettingsDialog(self.win, self.key, lambda k: self.win.refresh_all())

        def _on_switch(self, sw, *a):
            if self._updating:
                return
            active = sw.get_active()
            if active:
                set_wconf(self.key, dict(wconf(self.key), auto_restart=True))
                set_enabled(self.key, True)
                if not is_running(self.pattern):
                    start_widget(widget_cmd(self.key))
            else:
                set_enabled(self.key, False)
                stop_widget(self.pattern)
            GLib.timeout_add(500, self.win.refresh_all)

        def do_restart(self):
            enabled = not is_disabled(self.key)
            if is_running(self.pattern):
                stop_widget(self.pattern)
                time.sleep(0.8)
            if enabled:
                start_widget(widget_cmd(self.key))
            GLib.timeout_add(700, self.win.refresh_all)

        def do_stop(self):
            set_enabled(self.key, False)
            stop_widget(self.pattern)
            GLib.timeout_add(400, self.win.refresh_all)

        def refresh(self, running=None):
            running = is_running(self.pattern) if running is None else running
            disabled = is_disabled(self.key)
            if disabled:
                dot = '<span foreground="#9aa0a6">●</span>'
                state = '已禁用'
            elif running:
                dot = '<span foreground="#2ecc71">●</span>'
                state = '运行中'
            else:
                dot = '<span foreground="#e67e22">●</span>'
                state = '未运行'
            self.dot.set_markup(dot)

            conf = wconf(self.key)
            extra = []
            if conf.get('args'):
                extra.append('参数')
            if not conf.get('auto_restart', True):
                extra.append('不自动重启')
            if conf.get('font'):
                extra.append('字体 ' + conf['font'])
            tail = (' · ' + ' · '.join(extra)) if extra else ''
            self.name.set_markup(
                '<b>%s</b>\n<span foreground="#8b8b8b" size="small">%s · %s%s</span>'
                % (self.label, self.key, state, tail))

            self._updating = True
            self.switch.set_active(not disabled)
            self._updating = False

