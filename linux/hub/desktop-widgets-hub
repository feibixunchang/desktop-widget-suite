            self.refresh_all()
            GLib.timeout_add(3000, self._auto_refresh)
            GLib.timeout_add(2500, self._auto_check_update)

        # ── 状态刷新 ──
        def _auto_refresh(self):
            self.refresh_all(silent=True)
            return True

        def refresh_all(self, silent=False):
            running = running_keys()
            run = dis = 0
            for row in self.rows:
                disabled = is_disabled(row.key)
                row.refresh(running=row.key in running)
                if disabled:
                    dis += 1
                elif row.key in running:
                    run += 1
            total = len(self.rows)
            if not silent:
                self.status.set_markup(
                    '<span foreground="#8b8b8b" size="small">共 %d · 运行 %d · 停用 %d</span>'
                    % (total, run, dis))
            return False

