            restart_supervisor()
            GLib.timeout_add(900, self.refresh_all)
            self.status.set_markup('<span foreground="#3498db" size="small">守护已重启</span>')

        # ── 更新 ──
        def _auto_check_update(self):
            cache = cache_read()
            last = float(cache.get('checked_at') or 0)
            if time.time() - last < 12 * 3600:
                latest = cache.get('latest')
                if latest and _ver_tuple(latest) > _ver_tuple(installed_version()):
                    self.show_update_banner(latest)
                return False
            self._check_update(silent=True)
            return False

        def check_update_clicked(self):
            self._check_update(silent=False)

        def _check_update(self, silent):
            if self._busy:
                return
            self._busy = True
            self.btn_check.set_sensitive(False)
            self.update_lbl.set_markup('<span foreground="#8b8b8b" size="small">正在检查更新…</span>')

            def worker():
                res = check_update()
                GLib.idle_add(lambda: self._on_update_result(res, silent))

            threading.Thread(target=worker, daemon=True).start()

        def _on_update_result(self, res, silent):
            self._busy = False
            self.btn_check.set_sensitive(True)
            cur = installed_version()
            if not res.get('ok'):
                self.update_lbl.set_markup('<span foreground="#c0392b" size="small">检查失败：%s</span>'
                                           % GLib.markup_escape_text(res.get('error') or '未知错误'))
                if not silent:
                    dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                            message_type=Gtk.MessageType.WARNING,
                                            buttons=Gtk.ButtonsType.CLOSE,
                                            text='无法检查更新')
                    dlg.format_secondary_text((res.get('error') or '') +
                                              ('\n\n可以在「更新设置」里填写 GitHub 访问令牌或自定义更新源。'
                                               if res.get('need_token') else ''))
                    dlg.run(); dlg.destroy()
                return False
            latest = res['latest']
            cache_write(latest)
            if _ver_tuple(latest) > _ver_tuple(cur):
                self.update_lbl.set_markup('<span foreground="#2b7de1" size="small">发现新版本 %s</span>' % latest)
                self._update_info = res
                self.show_update_banner(latest)
            else:
                self.update_lbl.set_markup('<span foreground="#2ecc71" size="small">已是最新版本</span>')
                if not silent:
                    self.status.set_markup('<span foreground="#2ecc71" size="small">已是最新版本 v%s</span>' % cur)
            return False

        def show_update_banner(self, latest):
            self.banner_lbl.set_markup(
                '<b>发现新版本 %s</b> <span foreground="#8b8b8b" size="small">当前 v%s</span>'
                % (GLib.markup_escape_text(latest), installed_version()))
            self.banner.set_reveal_child(True)

        def open_update_settings(self):
            cfg = load_update_cfg()
            dlg = Gtk.Dialog(title='更新设置', transient_for=self, modal=True)
            dlg.add_button('取消', Gtk.ResponseType.CANCEL)
            dlg.add_button('保存', Gtk.ResponseType.OK)
            area = dlg.get_content_area()
            area.set_spacing(8)
            area.set_margin_start(16); area.set_margin_end(16)
            area.set_margin_top(12); area.set_margin_bottom(6)
            grid = Gtk.Grid(column_spacing=10, row_spacing=8)
            area.pack_start(grid, False, False, 0)

            def row(r, text, w, tip=''):
                lb = Gtk.Label(label=text); lb.set_xalign(0)
                if tip:
                    lb.set_tooltip_text(tip)
                grid.attach(lb, 0, r, 1, 1)
                w.set_hexpand(True); w.set_width_chars(34)
                grid.attach(w, 1, r, 1, 1)

            e_repo = Gtk.Entry(); e_repo.set_text(cfg.get('repo') or DEFAULT_REPO)
            row(0, 'GitHub 仓库', e_repo, 'owner/repo，私有仓库请同时填写令牌')
            e_token = Gtk.Entry(); e_token.set_text(cfg.get('token') or '')
            e_token.set_visibility(False)
            e_token.set_input_purpose(Gtk.InputPurpose.PASSWORD)
            row(1, '访问令牌', e_token, 'Personal Access Token，仅保存在本机 ~/.config/desktop-widgets/update.json（600 权限）')
            e_feed = Gtk.Entry(); e_feed.set_text(cfg.get('feed') or '')
            row(2, '自定义更新源', e_feed, '可选：返回 {"version":"x.y.z","deb":"下载地址"} 的 JSON 地址')
            hint = Gtk.Label()
            hint.set_markup('<span foreground="#8b8b8b" size="small">'
                            '留空令牌时会尝试匿名访问；私有仓库被拒时在此填入令牌即可。</span>')
            hint.set_xalign(0)
            area.pack_start(hint, False, False, 0)
            dlg.show_all()
            if dlg.run() == Gtk.ResponseType.OK:
                save_update_cfg({'repo': e_repo.get_text().strip() or DEFAULT_REPO,
                                 'token': e_token.get_text().strip(),
                                 'feed': e_feed.get_text().strip()})
                self._check_update(silent=True)
            dlg.destroy()

        def do_update(self):
            info = self._update_info
            if not info:
                self.check_update_clicked()
                return
            url = info.get('url') or ''
            if not url:
                dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                        message_type=Gtk.MessageType.WARNING,
                                        buttons=Gtk.ButtonsType.CLOSE,
                                        text='没有可下载的安装包')
                dlg.format_secondary_text('发行版中未找到 .deb 资源，请手动下载安装。')
                dlg.run(); dlg.destroy()
                return
            if not shutil.which('pkexec'):
                dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                        message_type=Gtk.MessageType.INFO,
                                        buttons=Gtk.ButtonsType.CLOSE,
                                        text='缺少 pkexec，无法自动安装')
                dlg.format_secondary_text('请手动下载后执行：\n'
                                          'sudo deepin-immutable-ctl admin exec -- dpkg -i 包.deb')
                dlg.run(); dlg.destroy()
                return

            token = load_update_cfg().get('token', '')
            # 下载目录优先放磁盘（~/.config/desktop-widgets/updates）：/tmp 若为
            # 小 tmpfs，58MB 的 deb 会直接 ENOSPC。
            dl_dir = os.path.join(MARK_DIR, 'updates')
            try:
                os.makedirs(dl_dir, exist_ok=True)
                if not os.access(dl_dir, os.W_OK):
                    raise PermissionError(dl_dir)
            except Exception:
                dl_dir = '/tmp'
            dest = os.path.join(dl_dir, '%s_%s_all.deb' % (PKG_NAME, info['latest']))
            self.btn_update.set_sensitive(False)
            self.banner_lbl.set_markup('<b>正在下载 %s…</b>' % GLib.markup_escape_text(info['latest']))

            def progress(got, total):
                pct = int(got * 100 / max(total, 1))
                GLib.idle_add(self._set_banner,
                              '<b>正在下载 %s…</b> <span foreground="#8b8b8b" size="small">%d%%</span>'
                              % (GLib.markup_escape_text(info['latest']), pct))

            def worker():
                try:
                    download(url, token, dest, progress, info.get('api_url'))
                    GLib.idle_add(self._set_banner, '<b>正在安装，请输入管理员密码…</b>')
                    r = subprocess.run(['pkexec', SELF, '--install-deb', dest])
                    GLib.idle_add(self._after_update, r.returncode, info['latest'], dest)
                except Exception as e:
                    GLib.idle_add(self._update_failed, str(e))

            threading.Thread(target=worker, daemon=True).start()

        def _set_banner(self, markup):
            self.banner_lbl.set_markup(markup)
            return False

        def _update_failed(self, msg):
            self.btn_update.set_sensitive(True)
            self.banner_lbl.set_markup('<b>更新失败</b>')
            dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                    message_type=Gtk.MessageType.ERROR,
                                    buttons=Gtk.ButtonsType.CLOSE, text='更新失败')
            dlg.format_secondary_text(msg)
            dlg.run(); dlg.destroy()
            return False

        def _after_update(self, code, latest, dest):
            self.btn_update.set_sensitive(True)
            if code != 0:
                return self._update_failed('安装返回码 %s（已取消或权限不足）' % code)
            self.status.set_markup('<span foreground="#2ecc71" size="small">已更新到 v%s</span>' % latest)
            self.banner_lbl.set_markup('<b>已更新到 v%s</b>' % latest)
            restart_supervisor()
            dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                    message_type=Gtk.MessageType.INFO,
                                    buttons=Gtk.ButtonsType.NONE,
                                    text='更新完成：v%s' % latest)
            dlg.format_secondary_text('挂件守护已重启。\n建议重启控制中心以加载新界面。')
            dlg.add_button('稍后', Gtk.ResponseType.CLOSE)
            dlg.add_button('立即重启', Gtk.ResponseType.OK)
            if dlg.run() == Gtk.ResponseType.OK:
                dlg.destroy()
                os.execv(SELF, [SELF])
            dlg.destroy()
            return False

        def show_about(self):
            dlg = Gtk.AboutDialog(transient_for=self, modal=True)
            dlg.set_program_name('桌面挂件控制中心')
            dlg.set_version(VERSION)
            dlg.set_comments('统一管理全部桌面挂件：启用开关、重启、独立设置、开机自启、一键全部启停。\n'
                             '含自愈守护，挂件异常退出会自动拉起。')
            dlg.set_license_type(Gtk.License.MIT_X11)
            if ICON:
                try:
                    dlg.set_icon_from_file(ICON)
                    dlg.set_logo(GdkPixbuf_from_file(ICON))
                except Exception:
                    pass
            dlg.run(); dlg.destroy()

    # ── 托盘 ──
    tray_state = {'ind': None, 'status_icon': None}

    def build_tray_menu(app, win):
        menu = Gtk.Menu()

        def item(text, cb):
            it = Gtk.MenuItem(label=text)
            it.connect('activate', lambda *_a: cb())
            menu.append(it)
            return it

        item('打开控制中心', lambda: (win.show_all(), win.present()))
        menu.append(Gtk.SeparatorMenuItem())
        item('全部启动', lambda: win.all_start(None))
        item('全部停止', lambda: win.all_stop(None))
        item('重启守护', lambda: win.restart_daemon(None))
        menu.append(Gtk.SeparatorMenuItem())
        auto_it = Gtk.CheckMenuItem(label='开机自启')
        auto_it.set_active(autostart_enabled())

        def toggle_auto(it):
            set_autostart(it.get_active())
            if win:
                win._updating_autostart = True
                win.autostart_switch.set_active(it.get_active())
                win._updating_autostart = False

        auto_it.connect('toggled', toggle_auto)
        menu.append(auto_it)
        item('检查更新…', lambda: (win.show_all(), win.present(), win.check_update_clicked()))
        menu.append(Gtk.SeparatorMenuItem())
        item('退出', lambda: app.quit())
        menu.show_all()
        tray_state['menu'] = menu
        tray_state['auto_item'] = auto_it
        return menu

    def setup_tray(app, win):
        menu = build_tray_menu(app, win)
        # 优先 Ayatana AppIndicator（Deepin/DDE 托盘原生支持）
        try:
            gi.require_version('AyatanaAppIndicator3', '0.1')
            from gi.repository import AyatanaAppIndicator3 as AppIndicator3
        except Exception:
            try:
                gi.require_version('AppIndicator3', '0.1')
                from gi.repository import AppIndicator3
            except Exception:
                AppIndicator3 = None
        if AppIndicator3 is not None and ICON:
            try:
                ind = AppIndicator3.Indicator.new(
                    APP_ID, ICON, AppIndicator3.IndicatorCategory.APPLICATION_STATUS)
                ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
                ind.set_title('桌面挂件控制中心')
                ind.set_menu(menu)
                try:
                    ind.set_secondary_activate_target(menu)
                except Exception:
                    pass
                tray_state['ind'] = ind
                return True
            except Exception as e:
                print('appindicator failed: %s' % e, file=sys.stderr)
        # 回退：老式 XEmbed 托盘
        try:
            si = Gtk.StatusIcon()
            if ICON:
                si.set_from_file(ICON)
            else:
                si.set_from_icon_name('preferences-system')
            si.set_tooltip_text('桌面挂件控制中心')
            si.connect('activate', lambda *_a: (win.show_all(), win.present()))
            si.connect('popup-menu', lambda _i, btn, t: menu.popup(
                None, None, Gtk.StatusIcon.position_menu, _i, btn, t))
            si.set_visible(True)
            tray_state['status_icon'] = si
            return True
        except Exception as e:
            print('tray unavailable: %s' % e, file=sys.stderr)
            return False

    from gi.repository import GdkPixbuf as _GdkPixbuf

    def GdkPixbuf_from_file(path):
        return _GdkPixbuf.Pixbuf.new_from_file(path)

    class HubApp(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID,
                             flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.win = None
            self.tray_ok = False

        def do_startup(self):
            Gtk.Application.do_startup(self)

        def do_activate(self):
            if self.win is None:
                self.win = HubWindow(self)
                self.win.show_all()
                self.win.banner.set_reveal_child(False)
                self.win.resize(600, 760)
                self.tray_ok = setup_tray(self, self.win)
            else:
                self.win.show_all()
                self.win.present()
                if getattr(self.win, 'tray_ok_hint_shown', False) is False and not self.tray_ok:
                    self.win.tray_ok_hint_shown = True

    # 保持进程存活（窗口隐藏后托盘仍在）
    app = HubApp()
    app.run(None)


def main():
    argv = sys.argv[1:]
    if '--version' in argv:
        print('desktop-widgets-hub %s' % VERSION)
        return 0
    if '--install-deb' in argv:
        i = argv.index('--install-deb')
        if i + 1 >= len(argv):
            print('用法: desktop-widgets-hub --install-deb <包.deb>', file=sys.stderr)
            return 2
        return install_deb_root(argv[i + 1])
    if '--check-update-cli' in argv:
        res = check_update()
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0 if res.get('ok') else 1
    run_app()
    return 0


if __name__ == '__main__':
    sys.exit(main())
