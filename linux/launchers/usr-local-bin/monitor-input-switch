#!/bin/bash
export PATH=/usr/local/bin:/usr/bin:$PATH
_wgt_off="$HOME/.config/desktop-widgets/monitor-input-switch.off"
mkdir -p "$(dirname "$_wgt_off")"
rm -f "$_wgt_off"
_wgt_t0=$(date +%s)
python3 /usr/local/lib/monitor-input-switch/main.py "$@"
_wgt_rc=$?
_wgt_dt=$(( $(date +%s) - _wgt_t0 ))
if [ "$_wgt_rc" -eq 0 ] && [ "$_wgt_dt" -ge 10 ]; then
    : > "$_wgt_off"
fi
exit $_wgt_rc
